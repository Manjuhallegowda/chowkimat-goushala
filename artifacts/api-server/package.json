{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate:local": "wrangler d1 migrations apply chowkimat --local",
    "db:migrate:remote": "wrangler d1 migrations apply chowkimat --remote",
    "seed:local": "wrangler d1 execute chowkimat --local --file=./seed.sql",
    "seed:remote": "wrangler d1 execute chowkimat --remote --file=./seed.sql"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "catalog:",
    "wrangler": "^4.14.0"
  }
}
